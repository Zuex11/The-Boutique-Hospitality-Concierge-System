<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="1100.0" stylesheets="@../Util/AppColors.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefHeight="750.0" prefWidth="1100.0" HBox.hgrow="ALWAYS">
         <children>

            <HBox prefHeight="56.0" prefWidth="1100.0" styleClass="top-nav" stylesheets="@../Util/AppColors.css">
               <children>
                  <Label styleClass="brand-label" stylesheets="@../Util/AppColors.css" text="VELOUR / Concierge System" />
                  <ScrollPane styleClass="nav-scroll" stylesheets="@../Util/AppColors.css" fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" HBox.hgrow="ALWAYS">
                     <content>
                        <HBox styleClass="nav-buttons" stylesheets="@../Util/AppColors.css">
                           <children>
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="GUEST REGISTRY" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="RESERVATIONS" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="CHECKOUT &amp; FOLIO" />
                              <Button mnemonicParsing="false" styleClass="nav-tab-active" stylesheets="@../Util/AppColors.css" text="HOTELS &amp; SUITES" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="CONCIERGE" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="REPORTS" />
                           </children>
                        </HBox>
                     </content>
                  </ScrollPane>
               </children>
            </HBox>

            <VBox prefWidth="1100.0" spacing="4.0" styleClass="page-header" stylesheets="@../Util/AppColors.css">
               <children>
                  <Label styleClass="page-title" stylesheets="@../Util/AppColors.css" text="Hotels &amp; Suites" />
                  <Label styleClass="page-subtitle" stylesheets="@../Util/AppColors.css" text="Add hotels · Define suite classes · Register individual suites" />
               </children>
            </VBox>

            <HBox VBox.vgrow="ALWAYS">
               <children>

                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="426.0" styleClass="reports-scroll" stylesheets="@../Util/AppColors.css" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox prefWidth="406.0" spacing="0.0">
                           <children>

                              <!-- FORM 1: ADD HOTEL -->
                              <VBox spacing="10.0" styleClass="left-col" stylesheets="@../Util/AppColors.css">
                                 <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                 <children>
                                    <Label styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Add Hotel" />
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="HOTEL NAME" />
                                          <TextField fx:id="hotelNameField" promptText="e.g. Velour Cairo" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                       </children>
                                    </VBox>
                                    <HBox spacing="12.0">
                                       <children>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="THEME" />
                                                <TextField fx:id="hotelThemeField" promptText="e.g. Art Deco" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="TOTAL SUITES" />
                                                <TextField fx:id="hotelSuiteCountField" promptText="e.g. 48" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="LOCATION" />
                                          <TextField fx:id="hotelLocationField" promptText="e.g. Zamalek, Cairo" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                       </children>
                                    </VBox>
                                    <HBox spacing="10.0">
                                       <padding><Insets top="10.0" /></padding>
                                       <children>
                                          <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="201.0" styleClass="btn-primary" stylesheets="@../Util/AppColors.css" text="+ ADD HOTEL" />
                                          <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="86.0" styleClass="btn-ghost" stylesheets="@../Util/AppColors.css" text="CLEAR" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- FORM 2: ADD SUITE CLASS -->
                              <VBox spacing="10.0" styleClass="left-col" stylesheets="@../Util/AppColors.css">
                                 <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                 <children>
                                    <Label styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Add Suite Class" />
                                    <HBox spacing="12.0">
                                       <children>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="CLASS NAME" />
                                                <TextField fx:id="classNameField" promptText="e.g. Penthouse" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="NIGHTLY RATE ($)" />
                                                <TextField fx:id="nightlyRateField" promptText="1200.00" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="AMENITIES" />
                                          <TextField fx:id="amenitiesField" promptText="Rooftop pool, Butler, Jacuzzi..." styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                       </children>
                                    </VBox>
                                    <HBox spacing="10.0">
                                       <padding><Insets top="10.0" /></padding>
                                       <children>
                                          <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="201.0" styleClass="btn-primary" stylesheets="@../Util/AppColors.css" text="+ ADD CLASS" />
                                          <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="86.0" styleClass="btn-ghost" stylesheets="@../Util/AppColors.css" text="CLEAR" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- FORM 3: ADD SUITE -->
                              <VBox spacing="10.0" styleClass="left-col" stylesheets="@../Util/AppColors.css">
                                 <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                 <children>
                                    <Label styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Add Suite" />
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="HOTEL" />
                                          <ComboBox fx:id="suiteHotelCombo" maxWidth="99999.0" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="SUITE CLASS" />
                                          <ComboBox fx:id="suiteClassCombo" maxWidth="99999.0" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0">
                                       <children>
                                          <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="SUITE NUMBER" />
                                          <TextField fx:id="suiteNumberField" promptText="e.g. 401-A" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                       </children>
                                    </VBox>
                                    <HBox spacing="10.0">
                                       <padding><Insets top="10.0" /></padding>
                                       <children>
                                          <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="201.0" styleClass="btn-primary" stylesheets="@../Util/AppColors.css" text="+ ADD SUITE" />
                                          <Button mnemonicParsing="false" prefHeight="41.0" prefWidth="86.0" styleClass="btn-ghost" stylesheets="@../Util/AppColors.css" text="CLEAR" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="reports-scroll" stylesheets="@../Util/AppColors.css" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                           <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                           <children>
                              <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="ALL HOTELS" />
                              <TableView fx:id="hotelTable" prefHeight="220.0" stylesheets="@../Util/AppColors.css" VBox.vgrow="NEVER">
                                 <columns>
                                    <TableColumn fx:id="colHotelId" prefWidth="78.0" text="HOTEL ID" />
                                    <TableColumn fx:id="colHotelName" prefWidth="132.0" text="NAME" />
                                    <TableColumn fx:id="colHotelTheme" prefWidth="110.0" text="THEME" />
                                    <TableColumn fx:id="colHotelLocation" prefWidth="140.0" text="LOCATION" />
                                    <TableColumn fx:id="colHotelSuites" prefWidth="80.0" text="SUITES" />
                                 </columns>
                              </TableView>
                              <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="ALL SUITE CLASSES" />
                              <TableView fx:id="suiteClassTable" prefHeight="220.0" stylesheets="@../Util/AppColors.css" VBox.vgrow="NEVER">
                                 <columns>
                                    <TableColumn fx:id="colClassId" prefWidth="77.0" text="CLASS ID" />
                                    <TableColumn fx:id="colClassName" prefWidth="123.0" text="CLASS NAME" />
                                    <TableColumn fx:id="colNightlyRate" prefWidth="120.0" text="NIGHTLY RATE ($)" />
                                    <TableColumn fx:id="colAmenities" prefWidth="220.0" text="AMENITIES" />
                                 </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>

               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</HBox>
