<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="750.0" prefWidth="1100.0"
      stylesheets="@../Util/AppColors.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.GuestScreen">
   <children>
      <VBox prefHeight="750.0" prefWidth="1100.0" HBox.hgrow="ALWAYS">
         <children>
            <VBox prefHeight="78.0" prefWidth="1096.0">
               <HBox prefHeight="56.0" prefWidth="1100.0" styleClass="top-nav" stylesheets="@../Util/AppColors.css">
               <children>
                  <Label styleClass="brand-label" stylesheets="@../Util/AppColors.css" text="VELOUR / Concierge System" />
                  <ScrollPane styleClass="nav-scroll" stylesheets="@../Util/AppColors.css" fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" HBox.hgrow="ALWAYS">
                     <content>
                        <HBox styleClass="nav-buttons" stylesheets="@../Util/AppColors.css">
                           <children>
                              <Button mnemonicParsing="false" styleClass="nav-tab-active" stylesheets="@../Util/AppColors.css" text="GUEST REGISTRY" />
                              <Button mnemonicParsing="false" onAction="#goReservation" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="RESERVATIONS" />
                              <Button mnemonicParsing="false" onAction="#goCheckout" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="CHECKOUT &amp; FOLIO" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="HOTELS &amp; SUITES" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="CONCIERGE" />
                              <Button mnemonicParsing="false" styleClass="nav-tab" stylesheets="@../Util/AppColors.css" text="REPORTS" />
                           </children>
                        </HBox>
                     </content>
                  </ScrollPane>
               </children>
            </HBox>
            </VBox>
            <VBox prefHeight="135.0" prefWidth="1100.0" spacing="4.0" styleClass="page-header" stylesheets="@../Util/AppColors.css">
               <children>
                  <Label styleClass="page-title" stylesheets="@../Util/AppColors.css" text="Guest Registry" />
                  <Label styleClass="page-subtitle" stylesheets="@../Util/AppColors.css" text="Register new guests · Update loyalty tier · Browse guest list" />
               </children>
            </VBox>
            <HBox prefHeight="605.0" prefWidth="1100.0">
               <children>
                  <VBox alignment="CENTER_LEFT" maxWidth="550.0" minWidth="550.0" prefHeight="583.0" prefWidth="550.0" styleClass="left-col" stylesheets="@../Util/AppColors.css">
                     <children>
                        <Label prefWidth="206.0" styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Register New Guest" />
                        <Label layoutX="10.0" layoutY="10.0" prefWidth="206.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="FULL NAME" />
                        <TextField fx:id="nameField" prefHeight="39.0" prefWidth="388.0" promptText="e.g. Mahmoud Ehab" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                        <Label prefWidth="206.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="EMAIL ADDRESS" />
                        <TextField fx:id="emailField" prefHeight="39.0" prefWidth="388.0" promptText="guest@email.com" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <VBox prefHeight="100.0" prefWidth="184.0">
                                 <children>
                                    <Label prefWidth="206.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="PHONE" />
                                    <TextField fx:id="phoneField" prefHeight="39.0" prefWidth="183.0" promptText="+20 10..." styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                 </children>
                              </VBox>
                              <Pane prefHeight="100.0" prefWidth="57.0" />
                              <VBox layoutX="216.0" layoutY="10.0" prefHeight="100.0" prefWidth="195.0">
                                 <children>
                                    <Label prefWidth="206.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="LOYALTY TIER" />
                                    <ComboBox fx:id="tierCombo" prefHeight="22.0" prefWidth="195.0" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox prefHeight="33.0" prefWidth="379.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#registerGuest" prefHeight="57.0" prefWidth="219.0" styleClass="btn-primary" stylesheets="@../Util/AppColors.css" text="+ REGISTER GUEST" />
                              <Pane layoutX="346.0" layoutY="10.0" prefHeight="59.0" prefWidth="25.0" />
                              <Button mnemonicParsing="false" onAction="#clearGuest" prefHeight="59.0" prefWidth="143.0" styleClass="btn-ghost" stylesheets="@../Util/AppColors.css" text="CLEAR" />
                              <Pane prefHeight="59.0" prefWidth="20.0" />
                              <Pane layoutX="211.0" layoutY="10.0" prefHeight="59.0" prefWidth="21.0" />
                           </children>
                        </HBox>
                        <Pane prefHeight="20.0" prefWidth="378.0" />
                        <Label styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Update Loyalty Tier" />
                        <Label layoutX="10.0" layoutY="369.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="GUEST ID" />
                        <TextField fx:id="updateIdField" prefHeight="39.0" prefWidth="388.0" promptText="e.g. 1042" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                        <Label layoutX="10.0" layoutY="407.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="NEW TIER" />
                        <ComboBox fx:id="updateTierCombo" prefHeight="21.0" prefWidth="370.0" styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                        <Pane prefHeight="23.0" prefWidth="370.0" />
                        <Button mnemonicParsing="false" onAction="#updateGuestTier" prefHeight="45.0" prefWidth="219.0" styleClass="btn-primary" stylesheets="@../Util/AppColors.css" text="UPDATE TIER" />
                     </children>
                  </VBox>
                  <VBox maxWidth="550.0" minWidth="550.0" prefHeight="200.0" prefWidth="550.0" styleClass="right-col" stylesheets="@../Util/AppColors.css">
                     <children>
                        <Label prefHeight="24.0" prefWidth="159.0" styleClass="field-label" stylesheets="@../Util/AppColors.css" text="ALL REGISTERED GUESTS" />
                        <TableView fx:id="guestTable" prefHeight="401.0" prefWidth="503.0" stylesheets="@../Util/AppColors.css">
                           <columns>
                              <TableColumn fx:id="colId" text="ID" />
                              <TableColumn fx:id="colName" prefWidth="111.0" text="NAME" />
                              <TableColumn fx:id="colEmail" prefWidth="137.0" text="EMAIL" />
                              <TableColumn fx:id="colPhone" minWidth="0.0" prefWidth="77.0" text="PHONE" />
                              <TableColumn fx:id="colTier" prefWidth="87.0" text="TIER" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
