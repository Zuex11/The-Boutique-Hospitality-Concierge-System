<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="750.0" prefWidth="1100.0"
      stylesheets="@../Util/AppColors.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.CheckoutScreen">
    <children>
        <VBox prefHeight="750.0" prefWidth="1100.0" HBox.hgrow="ALWAYS">
            <children>

                <!-- NAV BAR -->
                <HBox prefHeight="56.0" prefWidth="1100.0" styleClass="top-nav" stylesheets="@../Util/AppColors.css">
                    <children>
                        <Label styleClass="brand-label" stylesheets="@../Util/AppColors.css" text="VELOUR / Concierge System" />
                        <ScrollPane styleClass="nav-scroll" stylesheets="@../Util/AppColors.css"
                                    fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" HBox.hgrow="ALWAYS">
                            <content>
                                <HBox styleClass="nav-buttons" stylesheets="@../Util/AppColors.css">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#goGuest"       styleClass="nav-tab"        stylesheets="@../Util/AppColors.css" text="GUEST REGISTRY" />
                                        <Button mnemonicParsing="false" onAction="#goReservation" styleClass="nav-tab"        stylesheets="@../Util/AppColors.css" text="RESERVATIONS" />
                                        <Button mnemonicParsing="false"                           styleClass="nav-tab-active" stylesheets="@../Util/AppColors.css" text="CHECKOUT &amp; FOLIO" />
                                        <Button mnemonicParsing="false"                           styleClass="nav-tab"        stylesheets="@../Util/AppColors.css" text="HOTELS &amp; SUITES" />
                                        <Button mnemonicParsing="false"                           styleClass="nav-tab"        stylesheets="@../Util/AppColors.css" text="CONCIERGE" />
                                        <Button mnemonicParsing="false"                           styleClass="nav-tab"        stylesheets="@../Util/AppColors.css" text="REPORTS" />
                                    </children>
                                </HBox>
                            </content>
                        </ScrollPane>
                    </children>
                </HBox>

                <!-- PAGE HEADER -->
                <VBox prefHeight="135.0" prefWidth="1100.0" spacing="4.0" styleClass="page-header" stylesheets="@../Util/AppColors.css">
                    <children>
                        <Label styleClass="page-title"    stylesheets="@../Util/AppColors.css" text="Checkout &amp; Folio" />
                        <Label styleClass="page-subtitle" stylesheets="@../Util/AppColors.css" text="Add / remove experiences · View itemised guest bill (join query)" />
                    </children>
                </VBox>

                <!-- MAIN CONTENT -->
                <HBox prefHeight="605.0" prefWidth="1100.0">
                    <children>

                        <!-- LEFT: FORMS -->
                        <VBox alignment="CENTER_LEFT" maxWidth="550.0" minWidth="550.0"
                              prefHeight="583.0" prefWidth="550.0"
                              styleClass="left-col" stylesheets="@../Util/AppColors.css">
                            <children>

                                <Label styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Add Experience" />

                                <VBox prefHeight="81.0" prefWidth="493.0">
                                    <children>
                                        <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="RESERVATION ID" />
                                        <TextField fx:id="reservationIdField" onAction="#loadExperiences"
                                                   prefHeight="39.0" prefWidth="493.0"
                                                   promptText="e.g. 1002"
                                                   styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                    </children>
                                </VBox>

                                <VBox prefHeight="81.0" prefWidth="493.0">
                                    <children>
                                        <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="EXPERIENCE" />
                                        <ComboBox fx:id="experienceCombo" maxWidth="99999.0"
                                                  prefHeight="39.0" prefWidth="493.0"
                                                  styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                    </children>
                                </VBox>

                                <HBox prefHeight="81.0" prefWidth="493.0" spacing="20.0">
                                    <children>
                                        <VBox prefHeight="81.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="CONCIERGE ID" />
                                                <TextField fx:id="conciergeIdField"
                                                           promptText="e.g. 5"
                                                           styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                            </children>
                                        </VBox>
                                        <VBox prefHeight="81.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="ACTUAL COST ($)" />
                                                <TextField fx:id="actualCostField"
                                                           promptText="e.g. 150.00"
                                                           styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox prefHeight="59.0" prefWidth="493.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#addExperience"
                                                prefHeight="57.0" prefWidth="219.0"
                                                styleClass="btn-primary" stylesheets="@../Util/AppColors.css"
                                                text="+ ADD TO FOLIO" />
                                        <Pane prefHeight="59.0" prefWidth="25.0" />
                                        <Button mnemonicParsing="false" onAction="#clearAdd"
                                                prefHeight="59.0" prefWidth="143.0"
                                                styleClass="btn-ghost" stylesheets="@../Util/AppColors.css"
                                                text="CLEAR" />
                                    </children>
                                </HBox>

                                <Pane prefHeight="29.0" prefWidth="493.0" />

                                <Label styleClass="form-section-title" stylesheets="@../Util/AppColors.css" text="Remove Experience" />
                                <TextField editable="false" prefHeight="29.0" prefWidth="493.0"
                                           styleClass="info-pill" stylesheets="@../Util/AppColors.css"
                                           text=" ⚠  Permanently removes the experience from this folio" />

                                <VBox prefHeight="81.0" prefWidth="493.0">
                                    <children>
                                        <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="RES-EXPERIENCE ID" />
                                        <TextField fx:id="resExpIdField"
                                                   prefHeight="39.0" prefWidth="493.0"
                                                   promptText="e.g. 88"
                                                   styleClass="field-input" stylesheets="@../Util/AppColors.css" />
                                    </children>
                                </VBox>

                                <Pane prefHeight="15.0" prefWidth="493.0" />
                                <Button mnemonicParsing="false" onAction="#removeExperience"
                                        prefHeight="39.0" prefWidth="200.0"
                                        styleClass="btn-danger" stylesheets="@../Util/AppColors.css"
                                        text="X REMOVE" />

                            </children>
                        </VBox>

                        <!-- RIGHT: FOLIO -->
                        <VBox maxWidth="550.0" minWidth="550.0" prefHeight="583.0" prefWidth="550.0"
                              styleClass="right-col" stylesheets="@../Util/AppColors.css">
                            <children>
                                <Label styleClass="field-label" stylesheets="@../Util/AppColors.css" text="Guest Folio (JOIN)" />

                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                            styleClass="reports-scroll" stylesheets="@../Util/AppColors.css">
                                    <content>
                                        <VBox fx:id="folioBox" prefWidth="490.0" spacing="10.0" />
                                    </content>
                                </ScrollPane>

                                <Label fx:id="totalLabel" styleClass="total-amount"
                                       stylesheets="@../Util/AppColors.css" text="Total: $0.00" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</HBox>
